<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup rules for API 23-30.
    EncryptedSharedPreferences cannot be restored after reinstall because the
    Keystore key is deleted on uninstall — exclude it to prevent AEADBadTagException.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="apiary_secure_prefs.xml" />
</full-backup-content>
